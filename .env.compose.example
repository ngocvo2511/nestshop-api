# Copy to ignored .env.compose and generate independent values locally.
# These settings do not read the host app's .env or expose PostgreSQL ports.
COMPOSE_DB_PASSWORD=
COMPOSE_JWT_ACCESS_SECRET=
COMPOSE_API_PORT=3300

# Sandbox initiation only; callbacks/reachability are separate acceptance gates.
VNPAY_MODE=unconfigured
VNPAY_API_VERSION=2.1.0
VNPAY_LOCALE=vn
VNPAY_TIMEZONE=Asia/Ho_Chi_Minh
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
PAYMENT_ATTEMPT_SECONDS=1200

ORDER_RESERVATION_SECONDS=3600
EXPIRY_SCAN_INTERVAL_SECONDS=60
EXPIRY_SCAN_BATCH_SIZE=100
