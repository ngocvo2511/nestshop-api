# Copy to .env; fill blank DB/JWT secrets locally before starting.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Day 2 connects and requires migrations to be current before startup.
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=shop
DB_PASSWORD=
DB_DATABASE=shop

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=nestshop-api
JWT_AUDIENCE=nestshop-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

UPLOAD_DIRECTORY=uploads/products
UPLOAD_MAX_BYTES=5242880
ORDER_RESERVATION_SECONDS=3600
PAYMENT_ATTEMPT_SECONDS=1200
EXPIRY_SCAN_INTERVAL_SECONDS=60

# Optional Sandbox initiation. Leave merchant/callback values empty when unconfigured.
# sandbox requires all four values; callback reachability/provider acceptance is separate.
VNPAY_MODE=unconfigured
VNPAY_API_VERSION=2.1.0
VNPAY_LOCALE=vn
VNPAY_TIMEZONE=Asia/Ho_Chi_Minh
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=

# Controlled setup command only; keep blank outside initial-admin setup.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
